include icon.pug

section.section.archive.archive--articles
    div.container
        if archive.title
            .content.nizel-content(data-nizel-content)
                h2.h4= archive.title
        ul.archive-grid
            each item in archive.children
                li.archive-card(class=item.thumbnail ? "archive-card--media" : "", style=`${item.meta.sectionStyle ? item.meta.sectionStyle : ""}`)
                    a.archive-card__link(href=`${item.redirect ? item.redirect : item.link}`)
                        if item.thumbnail
                            span.archive-card__media.archive-card__media--image
                                img.archive-card__image(src=item.thumbnail, alt="", loading="lazy")
                        else if item.icon
                            +renderIcon(item.icon, "archive-card__media archive-card__media--icon", "archive-card__icon")
                        .archive-card__body
                            h3.archive-card__title= item.title
                            if item.excerpt
                                p.archive-card__excerpt
                                    | !{item.excerpt}
